{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // TypeScript 7 no longer pulls every @types/* package into the global
    // scope on its own, so `process` and `node:fs` stop resolving without
    // this. Naming the one we want is also what we wanted anyway.
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
