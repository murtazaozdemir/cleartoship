{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cleartoship",
  "compatibility_date": "2026-08-20",
  // Static landing page: no Worker script, just assets served from the edge.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
  // The custom domain (cleartoship.app / www) is bound once in the Cloudflare
  // dashboard, not here. Keeping it out of config means every automated build
  // deploys cleanly instead of re-attempting the domain binding on each push.
}
