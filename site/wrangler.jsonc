{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cleartoship",
  "compatibility_date": "2026-08-20",
  // Static landing page — no Worker script, just assets served from the edge.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Bind the apex and www to this Worker. wrangler provisions the custom
  // domains on deploy because the zone is on the same Cloudflare account.
  "routes": [
    { "pattern": "cleartoship.app", "custom_domain": true },
    { "pattern": "www.cleartoship.app", "custom_domain": true }
  ]
}
